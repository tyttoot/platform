{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TYT Doc Item",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "category": { "type": "string" },
    "title": { "type": "string" },
    "content": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "category", "title"],
  "additionalProperties": true
}
