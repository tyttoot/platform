:root {
  --bg: #0b0c10;
  --fg: #e5e7eb;
  --muted: #9ca3af;
  --accent: #22c55e;
  --border: #1f2937;
}

* {
  box-sizing: border-box;
}

html, body {
  height: 100%;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--fg);
  font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif;
}

.app {
  display: grid;
  grid-template-rows: auto 1fr;
  height: 100%;
}

header {
  padding: 16px;
  border-bottom: 1px solid var(--border);
}

main {
  padding: 20px;
}
