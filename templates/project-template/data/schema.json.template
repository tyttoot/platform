{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "{{NAME}} Data Schema",
  "type": "object",
  "required": ["id", "version"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "title": {
      "type": "string",
      "description": "Item title"
    },
    "content": {
      "type": "string",
      "description": "Main content"
    }
  }
}
